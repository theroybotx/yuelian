{
  "name": "yuelian-assistant",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "test:unit": "node --experimental-vm-modules --experimental-transform-types --test tests/assistant.test.ts tests/operations.test.mjs tests/testing.test.mjs tests/workspace-client.test.mjs tests/workspace-bridge.test.mjs tests/auth-unit.test.mjs tests/auth-client-races.test.mjs tests/policy.test.mjs tests/understanding-context.test.mjs tests/plan-amendment.test.ts tests/generation.test.mjs tests/semantic/oracle.test.mjs tests/semantic/intent-v1.1.test.mjs tests/transport-auth.test.mjs",
    "test:provider": "node --experimental-vm-modules --experimental-transform-types --import ./tests/isolation.mjs --test tests/assistant.test.ts tests/plan-amendment.test.ts tests/generation.test.mjs tests/model-provider.test.mjs tests/model-route.test.mjs",
    "test:provider:wiring": "node --test tests/provider-wiring.test.mjs",
    "test:ai:status": "node --experimental-vm-modules --import ./tests/isolation.mjs --test tests/ai-status.test.mjs tests/workspace-client.test.mjs tests/auth-client-races.test.mjs",
    "test:auth": "node --use-env-proxy --experimental-transform-types tests/auth-api.test.mjs",
    "test:integration": "node tests/full/run.mjs",
    "test:ui": "node tests/browser-ui.mjs",
    "test:browser": "node --use-env-proxy --experimental-transform-types tests/full/browser-business.mjs",
    "test:edge": "node tests/browser-edge.mjs",
    "test:browser:server": "node --experimental-transform-types tests/full/browser-server.mjs",
    "test:browser:auth": "node tests/full/browser-coach-auth.mjs",
    "test:functional": "node tests/browser-functional.mjs",
    "test:plan-ui": "node tests/browser-plan.mjs",
    "test:browser:booking": "node tests/full/browser-student-booking.mjs",
    "test:recovery-ui": "node tests/browser-recovery.mjs",
    "test:browser:undo": "node tests/full/browser-undo.mjs",
    "test:safety-ui": "node tests/browser-safety.mjs",
    "test:browser:relations": "node tests/full/browser-relations.mjs",
    "test:coverage": "node tests/full/coverage-review.mjs",
    "test:ai:ui": "node tests/browser-ai-v1.mjs",
    "test:ai:semantic": "node --use-env-proxy --experimental-transform-types tests/semantic/run.mjs",
    "build:trial": "node scripts/build-trial.mjs",
    "deploy:trial": "node scripts/build-trial.mjs && wrangler deploy --config cloudflare/wrangler.jsonc",
    "test:trial:worker": "node --test tests/trial-worker.test.mjs",
    "test:trial:auth": "node --use-env-proxy --experimental-transform-types tests/standalone-api.test.mjs",
    "test:trial:accounts": "node --test tests/provision-trial-accounts.test.mjs",
    "test:trial:browser": "node --use-env-proxy --experimental-transform-types tests/trial-browser.mjs",
    "build:vercel": "node scripts/build-vercel.mjs",
    "test:vercel": "node --test tests/vercel-adapter.test.mjs tests/vercel-output.test.mjs tests/vercel-origin.test.mjs tests/vercel-release.test.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "json-rpc-2.0": "1.7.1",
    "playwright": "1.65.0-alpha-2026-10-30",
    "raw-body": "3.0.2",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
}
